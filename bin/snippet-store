#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

readonly EXIT_USAGE=2
readonly EXIT_INVALID_JSON=3
readonly EXIT_UNSUPPORTED_SCHEMA=4
readonly EXIT_INVALID_CATALOG=5
readonly EXIT_IO=6
readonly MAX_CATALOG_BYTES=10485760

TEMP_PATH=""
BACKUP_TEMP=""
LOCK_FD=""

cleanup() {
  if [[ -n $TEMP_PATH && -e $TEMP_PATH ]]; then
    rm -f -- "$TEMP_PATH"
  fi
  if [[ -n $BACKUP_TEMP && -e $BACKUP_TEMP ]]; then
    rm -f -- "$BACKUP_TEMP"
  fi
}
trap cleanup EXIT HUP INT TERM

die() {
  local status="$1"
  local message="$2"
  printf '%s\n' "$message" >&2
  exit "$status"
}

xdg_data_home() {
  if [[ -n ${XDG_DATA_HOME:-} && ${XDG_DATA_HOME:0:1} == "/" ]]; then
    printf '%s\n' "$XDG_DATA_HOME"
    return
  fi

  [[ -n ${HOME:-} && ${HOME:0:1} == "/" ]] || die "$EXIT_IO" "Unable to resolve snippet data directory"
  printf '%s/.local/share\n' "$HOME"
}

assert_regular_file() {
  local path="$1"

  if [[ -L $path ]]; then
    die "$EXIT_IO" "Unable to read snippet catalog"
  fi
  if [[ -e $path && ! -f $path ]]; then
    die "$EXIT_IO" "Unable to read snippet catalog"
  fi
}

validate_file() {
  local path="$1"
  local schema_status
  local size

  assert_regular_file "$path"
  [[ -r $path ]] || die "$EXIT_IO" "Unable to read snippet catalog"
  command -v jq >/dev/null 2>&1 || die "$EXIT_IO" "Unable to read snippet catalog"
  size=$(stat -c '%s' "$path" 2>/dev/null) || die "$EXIT_IO" "Unable to read snippet catalog"
  if (( size > MAX_CATALOG_BYTES )); then
    die "$EXIT_INVALID_CATALOG" "Invalid snippet catalog"
  fi

  if ! jq -e -s 'length == 1' "$path" >/dev/null 2>&1; then
    die "$EXIT_INVALID_JSON" "Snippet catalog is not valid JSON"
  fi

  schema_status=$(jq -r '
    if type != "object" or (has("schemaVersion") | not) then "missing"
    elif ((.schemaVersion | type) == "number") and .schemaVersion == 1 then "valid"
    else "unsupported"
    end
  ' "$path") || die "$EXIT_IO" "Unable to read snippet catalog"

  if [[ $schema_status == "missing" ]]; then
    die "$EXIT_INVALID_CATALOG" "Invalid snippet catalog"
  fi
  if [[ $schema_status != "valid" ]]; then
    die "$EXIT_UNSUPPORTED_SCHEMA" "Unsupported snippet catalog schema"
  fi

  if ! jq -e '
    def js_trim: gsub("^[\\s\uFEFF]+|[\\s\uFEFF]+$"; "");
    def has_non_js_whitespace: test("[^\\s\uFEFF]");
    def canonical_timestamp:
      test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$")
      and ((.[0:4] | tonumber) >= 1970)
      and ((.[11:13] | tonumber) < 24)
      and ((.[14:16] | tonumber) < 60)
      and ((.[17:19] | tonumber) < 60)
      and (
        (sub("\\.[0-9]{3}Z$"; "Z")) as $time
        | try (($time | fromdateiso8601 | strftime("%Y-%m-%dT%H:%M:%SZ")) == $time) catch false
      );

    type == "object"
    and (.snippets | type == "array" and length < 500)
    and all(.snippets[];
      type == "object"
      and ((.id | type) == "string")
      and (.id | test("^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"; "i"))
      and ((.title | type) == "string")
      and (.title | js_trim | length >= 1 and length <= 120)
      and ((.content | type) == "string")
      and (.content | has_non_js_whitespace)
      and ((.createdAt | type) == "string")
      and (.createdAt | canonical_timestamp)
      and ((.updatedAt | type) == "string")
      and (.updatedAt | canonical_timestamp)
      and (
        (has("lastUsedAt") | not)
        or .lastUsedAt == null
        or (
          ((.lastUsedAt | type) == "string")
          and (.lastUsedAt | canonical_timestamp)
        )
      )
    )
    and (([.snippets[].id | ascii_downcase] | length) == ([.snippets[].id | ascii_downcase] | unique | length))
  ' "$path" >/dev/null 2>&1; then
    die "$EXIT_INVALID_CATALOG" "Invalid snippet catalog"
  fi
}

sync_file() {
  sync -f "$1" 2>/dev/null || die "$EXIT_IO" "Unable to persist snippet catalog"
}

acquire_lock() {
  local mode="$1"

  if [[ -L $DATA_DIR ]]; then
    die "$EXIT_IO" "Unable to secure snippet data directory"
  fi
  mkdir -p -m 700 -- "$DATA_DIR" || die "$EXIT_IO" "Unable to create snippet data directory"
  chmod 700 -- "$DATA_DIR" || die "$EXIT_IO" "Unable to secure snippet data directory"

  local lock_path="$DATA_DIR/.lock"
  if [[ -L $lock_path || (-e $lock_path && ! -f $lock_path) ]]; then
    die "$EXIT_IO" "Unable to lock snippet catalog"
  fi
  exec {LOCK_FD}>"$lock_path" || die "$EXIT_IO" "Unable to lock snippet catalog"
  chmod 600 -- "$lock_path" || die "$EXIT_IO" "Unable to secure snippet catalog lock"

  if [[ $mode == "shared" ]]; then
    flock -s "$LOCK_FD" || die "$EXIT_IO" "Unable to lock snippet catalog"
  else
    flock -x "$LOCK_FD" || die "$EXIT_IO" "Unable to lock snippet catalog"
  fi
}

readonly DATA_DIR="$(xdg_data_home)/omarchy-snippets"
readonly PRIMARY_PATH="$DATA_DIR/snippets.json"
readonly BACKUP_PATH="$PRIMARY_PATH.bak"

if [[ $# -ne 1 ]]; then
  die "$EXIT_USAGE" "Usage: snippet-store {read|write|restore-backup}"
fi
readonly COMMAND="$1"

case "$COMMAND" in
  read)
    acquire_lock shared
    assert_regular_file "$PRIMARY_PATH"

    if [[ ! -e $PRIMARY_PATH ]]; then
      printf '{\n  "schemaVersion": 1,\n  "snippets": []\n}\n'
      exit 0
    fi

    validate_file "$PRIMARY_PATH"
    cat -- "$PRIMARY_PATH" || die "$EXIT_IO" "Unable to read snippet catalog"
    ;;

  write)
    acquire_lock exclusive
    assert_regular_file "$PRIMARY_PATH"
    assert_regular_file "$BACKUP_PATH"

    TEMP_PATH=$(mktemp "$DATA_DIR/.snippets.XXXXXX") || die "$EXIT_IO" "Unable to create temporary catalog"
    chmod 600 -- "$TEMP_PATH" || die "$EXIT_IO" "Unable to secure temporary catalog"
    head -c $((MAX_CATALOG_BYTES + 1)) >"$TEMP_PATH" || die "$EXIT_IO" "Unable to read snippet catalog input"
    input_size=$(stat -c '%s' "$TEMP_PATH" 2>/dev/null) || die "$EXIT_IO" "Unable to read snippet catalog input"
    if (( input_size > MAX_CATALOG_BYTES )); then
      die "$EXIT_INVALID_CATALOG" "Invalid snippet catalog"
    fi
    validate_file "$TEMP_PATH"
    sync_file "$TEMP_PATH"

    if [[ -e $PRIMARY_PATH ]]; then
      validate_file "$PRIMARY_PATH"
      BACKUP_TEMP=$(mktemp "$DATA_DIR/.backup.XXXXXX") || die "$EXIT_IO" "Unable to create temporary backup"
      cp -- "$PRIMARY_PATH" "$BACKUP_TEMP" || die "$EXIT_IO" "Unable to back up snippet catalog"
      chmod 600 -- "$BACKUP_TEMP" || die "$EXIT_IO" "Unable to secure snippet catalog backup"
      sync_file "$BACKUP_TEMP"
      mv -f -- "$BACKUP_TEMP" "$BACKUP_PATH" || die "$EXIT_IO" "Unable to install snippet catalog backup"
      BACKUP_TEMP=""
    fi

    mv -f -- "$TEMP_PATH" "$PRIMARY_PATH" || die "$EXIT_IO" "Unable to install snippet catalog"
    TEMP_PATH=""
    sync_file "$DATA_DIR"
    ;;

  restore-backup)
    acquire_lock exclusive
    assert_regular_file "$BACKUP_PATH"
    [[ -e $BACKUP_PATH ]] || die "$EXIT_IO" "Snippet catalog backup not found"
    validate_file "$BACKUP_PATH"

    assert_regular_file "$PRIMARY_PATH"
    if [[ -e $PRIMARY_PATH ]]; then
      if (validate_file "$PRIMARY_PATH") >/dev/null 2>&1; then
        die "$EXIT_IO" "Refusing to overwrite a valid snippet catalog"
      else
        primary_status=$?
        if [[ $primary_status -eq $EXIT_IO ]]; then
          die "$EXIT_IO" "Unable to read snippet catalog"
        fi
      fi

      corrupt_timestamp=$(date -u +%Y%m%dT%H%M%SZ) || die "$EXIT_IO" "Unable to timestamp preserved snippet catalog"
      corrupt_path="$PRIMARY_PATH.corrupt-$corrupt_timestamp"
      suffix=1
      while [[ -e $corrupt_path ]]; do
        corrupt_path="$PRIMARY_PATH.corrupt-$corrupt_timestamp-$suffix"
        suffix=$((suffix + 1))
      done

      BACKUP_TEMP=$(mktemp "$DATA_DIR/.corrupt.XXXXXX") || die "$EXIT_IO" "Unable to preserve malformed snippet catalog"
      cp -- "$PRIMARY_PATH" "$BACKUP_TEMP" || die "$EXIT_IO" "Unable to preserve malformed snippet catalog"
      chmod 600 -- "$BACKUP_TEMP" || die "$EXIT_IO" "Unable to secure preserved snippet catalog"
      sync_file "$BACKUP_TEMP"
      mv -f -- "$BACKUP_TEMP" "$corrupt_path" || die "$EXIT_IO" "Unable to preserve malformed snippet catalog"
      BACKUP_TEMP=""
    fi

    TEMP_PATH=$(mktemp "$DATA_DIR/.restore.XXXXXX") || die "$EXIT_IO" "Unable to create restore file"
    cp -- "$BACKUP_PATH" "$TEMP_PATH" || die "$EXIT_IO" "Unable to copy snippet catalog backup"
    chmod 600 -- "$TEMP_PATH" || die "$EXIT_IO" "Unable to secure restored snippet catalog"
    validate_file "$TEMP_PATH"
    sync_file "$TEMP_PATH"
    mv -f -- "$TEMP_PATH" "$PRIMARY_PATH" || die "$EXIT_IO" "Unable to restore snippet catalog backup"
    TEMP_PATH=""
    sync_file "$DATA_DIR"
    ;;

  *)
    die "$EXIT_USAGE" "Usage: snippet-store {read|write|restore-backup}"
    ;;
esac
