#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

readonly EXIT_USAGE=2
readonly EXIT_IO=6

die() {
  local status="$1"
  local message="$2"
  printf '%s\n' "$message" >&2
  exit "$status"
}

verb=${1:-}
[[ $verb == "copy" || $verb == "paste" ]] || die "$EXIT_USAGE" "Transfer request was invalid"

input=$(cat; printf x) || true
input=${input%x}
[[ -n $input ]] || die "$EXIT_USAGE" "Transfer request was invalid"

command -v wl-copy >/dev/null 2>&1 || die "$EXIT_IO" "Unable to transfer snippet"

printf '%s' "$input" | wl-copy --type text/plain || die "$EXIT_IO" "Unable to transfer snippet"

if [[ $verb == "paste" ]]; then
  command -v sleep >/dev/null 2>&1 || die "$EXIT_IO" "Unable to transfer snippet"
  command -v wtype >/dev/null 2>&1 || die "$EXIT_IO" "Unable to transfer snippet"
  sleep 0.15 || die "$EXIT_IO" "Unable to transfer snippet"
  wtype -M shift -k Insert -m shift || die "$EXIT_IO" "Unable to transfer snippet"
fi
