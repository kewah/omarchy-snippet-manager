{
  "name": "omarchy-snippet-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Dev tooling for the Omarchy Snippets overlay plugin",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run lint && npm run test:js && npm run test:shell",
    "test:js": "node --test tests/**/*.test.js",
    "test:shell": "bash tests/snippet-catalog/storage.test.sh && bash tests/snippet-transfer/helper.test.sh && bash tests/omarchy-integration/install.test.sh",
    "test:smoke": "bash tests/snippet-overlay/runtime-smoke.sh",
    "validate": "node scripts/validate-plugin.js",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.{json,md,mjs}": "prettier --write"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@12.0.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "lint-staged": "^17.4.1",
    "prettier": "3.9.6",
    "simple-git-hooks": "^2.14.0"
  }
}
